{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HueBeat",
  "version": "2.0.0",
  "identifier": "com.huebeat.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HueBeat",
        "width": 1080,
        "height": 720,
        "minWidth": 980,
        "minHeight": 660,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#08090d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "HueBeat",
    "copyright": "HueBeat",
    "category": "Utility",
    "shortDescription": "Album color sync, beat detection and media controls",
    "longDescription": "HueBeat reads the current track's album art, drives an Arduino RGB LED and OpenRGB devices with its dominant color, pulses on the beat and exposes media controls from a compact window or the system tray.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
